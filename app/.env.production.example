# Laravel Cloud reference: configure real values in settings/secrets, not in Git.
# Do not override Cloud-injected values with these empty placeholders.
APP_NAME="Muse Media Ops"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://muse.example.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Attach separate managed MySQL and Redis resources for each environment.
DB_CONNECTION=mysql
DB_HOST=replace-with-cloud-mysql-host
DB_PORT=3306
DB_DATABASE=replace-with-production-database
DB_USERNAME=replace-with-app-user
DB_PASSWORD=

# Laravel Cloud sets QUEUE_CONNECTION=cloud (managed queue) and REDIS_*/CACHE_STORE for Valkey.
QUEUE_CONNECTION=cloud
REDIS_CLIENT=phpredis
REDIS_HOST=replace-with-cloud-redis-host
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
# Prefer Cloud's injected REDIS_URL when supplied, including its TLS scheme.
REDIS_DB=0
REDIS_CACHE_DB=0
REDIS_PREFIX=muse-production-database-
CACHE_STORE=redis
CACHE_PREFIX=muse-production-cache-
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true

# Laravel Cloud Object Storage (Cloudflare R2, private bucket) injects FILESYSTEM_DISK and AWS_*.
# No AWS_ENDPOINT or AWS_URL override; use the bucket's actual AWS region.
# Bucket owner preferred + same-account app IAM user; private-ACL permission per checklist.
FILESYSTEM_DISK=inputs
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=replace-with-private-production-bucket
AWS_USE_PATH_STYLE_ENDPOINT=false

# presigned on Laravel Cloud (R2 temporary URLs); cloudfront only for a self-managed S3 + CloudFront setup.
MEDIA_URL_PROVIDER=presigned
MEDIA_SIGNED_URL_TTL=600
CLOUDFRONT_DOMAIN=replace-with-distribution.cloudfront.net
CLOUDFRONT_KEY_PAIR_ID=replace-with-public-key-id
# Cloud secret: single-line base64 of an unencrypted PEM (encoding, not encryption).
# Takes precedence over the path; invalid content fails closed.
CLOUDFRONT_PRIVATE_KEY_BASE64=
# Alternative for hosts that provision a readable PEM on every replica.
CLOUDFRONT_PRIVATE_KEY_PATH=

FAKE_ENGINE=false
# Brand keys override this optional studio fallback; live qualification is deferred.
KREA_API_KEY=
